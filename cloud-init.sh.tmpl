echo "Making docker socket less secure"
sudo chmod 777 /var/run/docker.sock

# GHASR-92 / GHASR-95: trust the two per-host pull-through caches. Both serve
# plain HTTP on the internal gateway (registry-ghcr.internal:5556 and
# registry-dockerhub.internal:5555 -> 10.1.0.1, resolved via libvirt DNS), so
# docker must treat them as insecure registries. Merge into any existing
# daemon.json rather than clobbering it.
#
# The two caches are reached differently:
#   - ghcr: by rewriting the image name (the Kong-ee vars.GHCR_REGISTRY switch),
#     so insecure-registries is all docker needs from us.
#   - Docker Hub: by registry-mirrors, so image names in workflows stay as-is.
#     Both keys are required — with only registry-mirrors docker does not error,
#     it silently falls back to upstream and the cache never gets a hit.
echo "Configuring pull-through caches as insecure registries"
sudo mkdir -p /etc/docker
existing_daemon=$(cat /etc/docker/daemon.json 2>/dev/null)
# treat missing/empty/invalid json as {} so a bad file can't wipe the config
if ! echo "$existing_daemon" | jq -e . >/dev/null 2>&1; then
	existing_daemon='{}'
fi
merged_daemon=$(echo "$existing_daemon" | jq '
	.["insecure-registries"] = ((.["insecure-registries"] // []) + ["registry-ghcr.internal:5556", "registry-dockerhub.internal:5555"] | unique)
	| .["registry-mirrors"] = ((.["registry-mirrors"] // []) + ["http://registry-dockerhub.internal:5555"] | unique)
')
# only overwrite if jq produced valid output, otherwise leave the file untouched
if [[ -n "$merged_daemon" ]]; then
	echo "$merged_daemon" | sudo tee /etc/docker/daemon.json > /dev/null
	sudo systemctl restart docker
fi
# socket perms are reset by the restart above
sudo chmod 777 /var/run/docker.sock

if [[ ! -z "${DOCKER_USER}" && ! -z "${DOCKER_PASS}" ]]; then
	echo "Login docker"
	echo "${DOCKER_PASS}" | docker login --username ${DOCKER_USER} --password-stdin
fi

echo "Update source"
#sudo sysctl net.ipv6.conf.all.disable_ipv6=1
sudo sed -i 's/azure\.archive\.ubuntu\.com\/ubuntu/mirror\.hetzner\.com\/ubuntu\/packages/' /etc/apt/sources.list
sudo sed -i 's/archive\.ubuntu\.com\/ubuntu/mirror\.hetzner\.com\/ubuntu\/packages/' /etc/apt/sources.list
sudo sed -i 's/security\.ubuntu\.com\/ubuntu/mirror\.hetzner\.com\/ubuntu\/packages/' /etc/apt/sources.list

echo "Start installing actions runner ${RUNNER_VER}"

echo "User $USER, UID: $(id)"

# Re-source the env vars to evaluate variables like $HOME
source /etc/environment

cd # goto my home

mkdir actions-runner && cd actions-runner

ARCH=$(arch)
if [[ $ARCH == "x86_64" ]]; then ARCH=x64
else ARCH=arm64
fi

cat << 'EOF' > start.sh
#!/bin/bash
date +%s%3N > /tmp/job_start.ts
EOF

cat << EOF > stop.sh
#!/bin/bash
now_ts=\$(date +%s%3N)
start_ts=\$(cat /tmp/job_start.ts)
job_duration_ms=\$((now_ts - start_ts))
function send_metrics() {
  metrics="github.actions.\$1:\$${2:-1}|\$${3:-c}|#runner_group:${RUNNERGROUP}"
  metrics=\$metrics,#repo:\$GITHUB_REPOSITORY,#workflow:\$GITHUB_WORKFLOW,#job:\$GITHUB_JOB,#arch:$ARCH
  echo "Send metrics \$metrics to $dd_host"
  echo -n "\$metrics" > /dev/udp/$dd_host/8125
}
send_metrics jobs.repo
send_metrics jobs.duration \$job_duration_ms "ms|@1"
EOF

curl -o actions-runner-linux-$${ARCH}-${RUNNER_VER}.tar.gz -L https://github.com/actions/runner/releases/download/v${RUNNER_VER}/actions-runner-linux-$${ARCH}-${RUNNER_VER}.tar.gz

tar xzf ./actions-runner-linux-$${ARCH}-${RUNNER_VER}.tar.gz

sudo mkdir /work
sudo chown $USER /work

cat /imagegeneration/imagedata.json|jq  ".[1].detail |=  .+ \"\nCloud Image Serial: $cloud_image_serial\"" > .setup_info

IFS=$'\r\n'
./config.sh \
	--unattended \
	--replace \
	--ephemeral \
	--name "${NAME}" \
	--work /work \
	--labels "${LABELS}" \
	--runnergroup "${RUNNERGROUP}" \
	--url "${URL}" \
	--token "${TOKEN}" | grep -vE "^[ \t|/_\\()',\.\-]*$"| grep -vF 'Self-hosted runner registration' | while read line; do
		echo $line
		send_logs runner_log $line
done
IFS=$' \t\n'


# temporary hack
runner_config=/home/ubuntu/actions-runner/.runner
if [[ ! -e $runner_config ]]; then
    send_logs runner_log "First pass not authenticated, trying hack way"

    IFS=$'\r\n'

    ./config.sh \
            --unattended \
            --replace \
            --name "${NAME}" \
            --work /work \
            --labels "${LABELS}" \
            --runnergroup "${RUNNERGROUP}" \
            --url "${URL}" \
            --token "${TOKEN}" | while read line; do
                    echo $line
                    send_logs runner_log $line
    done

    IFS=$' \t\n'

    jq '.ephemeral=true' $runner_config > x.runner
    mv x.runner $runner_config
fi

send_metrics runners.registered

function finish {
	./config.sh remove --token "${TOKEN}" || true
}
trap finish EXIT

provision_duration_ms=$(awk '{print $1*1000}' /proc/uptime)
send_metrics runner.provision_duration $provision_duration_ms "ms|@1"

# GHASR-97: Runner.Listener can wedge after it has claimed a job — the process
# stays alive on an established but dead broker connection, never times out and
# never retries. GitHub drops the runner on heartbeat timeout, but the host sees
# the domain as running and never rebuilds it, so the worker is lost for good.
#
# Ship the tail of the runner's own log before powering off. The VM is destroyed
# immediately afterwards, so this is the only chance to learn anything about why
# it wedged; without it every recycle is a black box.
function capture_diag() {
	# quotes and backslashes would break the JSON send_logs builds by hand
	tail -n 40 "$1" 2>/dev/null | tr -d '"\\' | cut -c1-500 | while read -r l; do
		send_logs runner_diag "$l"
	done
}

# Two situations are handled here, and only one of them acts.
#
# 1. Already claimed a job and then went silent — the INC-849 wedge. The job is
#    lost either way, since GitHub gives up after exactly ten minutes, so all
#    that is left to do is recycle the VM and get the capacity back.
#
# 2. Lost the broker connection while still idle. In the one wedge captured in
#    full, the listener logged a connect error and wedged 38 seconds later, on
#    the job it claimed the instant it reconnected. Recycling at the point of
#    the error would get ahead of that, and it is tempting: no job has been
#    claimed yet, so none would be lost.
#
#    We do not do it. That same runner had already recovered once from the very
#    same error — the connect error at 12:32:27 was followed by a successful
#    reconnect at 12:33:05. So at the moment the error is logged, a blip that
#    recovers and a blip that goes on to wedge are indistinguishable, and no
#    refinement of the trigger can separate them. Whether recycling is worth it
#    depends entirely on what fraction of connect errors end in a wedge, and we
#    do not know that fraction. Guessing it wrong is expensive: the fleet boots
#    on the order of 900 VMs an hour, so even a small share of boots hitting a
#    transient connect error would mean recycling healthy runners constantly.
#
#    So this branch counts and captures, and leaves the runner alone. Comparing
#    the connect_error_seen and listener_stalled rates gives the fraction, and
#    turning recycling on afterwards is a one-line change backed by data.
#
# A job genuinely in progress owns the VM and is never touched, in either case.
function runner_watchdog() {
	diag_dir=/home/ubuntu/actions-runner/_diag
	stall_limit=600
	# the error line stays in the log forever, so report it once per VM rather
	# than once per poll, or the rate we are trying to measure is meaningless
	reported=/tmp/connect-error-reported

	while true; do
		# 38s elapsed between connect error and job claim in the captured wedge.
		# Polling well inside that is what lets us tell whether the error came
		# before the claim, which is the population recycling would act on.
		sleep 10

		diag=$(ls -t $diag_dir/Runner_*.log 2>/dev/null | head -n 1)
		if [[ -z $diag ]]; then
			continue
		fi

		if pgrep -f '[R]unner\.Worker' >/dev/null; then
			continue
		fi

		if grep -q 'Acknowledging runner request' "$diag"; then
			age=$(( $(date +%s) - $(stat -c %Y "$diag") ))
			if [[ $age -gt $stall_limit ]]; then
				capture_diag "$diag"
				send_metrics runners.anomaly "1" "c" "#runner_name:${NAME},#type:listener_stalled"
				send_logs runner_log "Listener stalled $age seconds after claiming a job, powering off for rebuild"
				sleep 2 # let the UDP metrics leave before the interface goes down
				sudo poweroff
				return
			fi
		elif [[ ! -e $reported ]] && grep -q 'Runner connect error' "$diag"; then
			touch $reported
			capture_diag "$diag"
			send_metrics runners.anomaly "1" "c" "#runner_name:${NAME},#type:connect_error_seen"
			send_logs runner_log "Broker connect error while idle, recorded for GHASR-97, no action taken"
		fi
	done
}
runner_watchdog &

# GHASR-97: the watchdog above only covers a listener that wedges after claiming
# a job. A listener that never reaches "Listening for Jobs" is equally invisible
# to the host, so bound the provisioning phase too. A healthy VM gets there in
# well under a minute, which makes ten minutes a deliberately loose bound.
function provision_watchdog() {
	sleep 600
	if ! grep -qs 'Listening for Jobs' /home/ubuntu/actions-runner/_diag/Runner_*.log; then
		send_metrics runners.anomaly "1" "c" "#runner_name:${NAME},#type:never_listening"
		send_logs runner_log "Runner never reached 'Listening for Jobs', powering off for rebuild"
		sleep 2
		sudo poweroff
	fi
}
provision_watchdog &

IFS=$'\r\n'
export ACTIONS_RUNNER_HOOK_JOB_STARTED=/home/ubuntu/actions-runner/start.sh
export ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/home/ubuntu/actions-runner/stop.sh
./run.sh | grep --line-buffered -vE "^[ \t|/_\\()',\.\-]*$"| grep --line-buffered -vF 'Self-hosted runner registration' | while read line; do
	echo $line
	if echo $line | grep -q "Running job: "; then
		ts=$(echo $line | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}Z')
		start_time=$(date -u -d "$ts" +%s)
	fi
	send_logs runner_log $line
done
# GHASR-97: capture run.sh's status before anything else runs. This used to read
# $? after the IFS assignment below, so it was always 0 — jobs.completed always
# reported success and runner_exit always reported 0, no matter how the runner
# died. PIPESTATUS[0] is run.sh itself rather than the tail of the pipeline.
status=$${PIPESTATUS[0]}
IFS=$' \t\n'

if [[ $status -eq 0 ]]; then send_metrics jobs.completed; fi
send_logs runner_exit $status

./config.sh remove --token "${TOKEN}" || true

sudo poweroff

